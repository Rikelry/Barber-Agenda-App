# Copie para .env e preencha com os IDs do OAuth Client criados no Google Cloud Console.
# Variáveis com o prefixo EXPO_PUBLIC_ ficam disponíveis no app em tempo de build.

# Endereço do backend. No emulador, localhost funciona; num celular físico, use o IP
# da sua máquina na rede (ex.: http://192.168.0.10:3000/api/v1).
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# OAuth Client ID do tipo "Web application". É o audience usado para emitir o ID token
# e o valor validado no backend (GOOGLE_CLIENT_ID). Obrigatório — sem ele não há login.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# OAuth Client ID do tipo "iOS". Só é necessário para o app no iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
